fun main() {
    System.out.println(5 == 5)
    System.out.println(5 == 7)

    System.out.println(5 != 5)
    System.out.println(5 != 7)

    System.out.println(5 > 4)
    System.out.println(5 > 5)
    System.out.println(5 > 6)

    System.out.println(5 < 4)
    System.out.println(5 < 5)
    System.out.println(5 < 6)

    System.out.println(5 >= 4)
    System.out.println(5 >= 5)
    System.out.println(5 >= 6)

    System.out.println(5 <= 4)
    System.out.println(5 <= 5)
    System.out.println(5 <= 6)
}