fun main() {
    System.out.println(1 + 2 * 3)
    System.out.println(2 * 3 + 1)

    System.out.println((1 + 2) * 3)
    System.out.println(2 * (3 + 1))

    System.out.println(4 + 12 / 2)
    System.out.println(12 / 2 + 4)

    System.out.println((4 + 12) / 2)
    System.out.println(12 / (2 + 4))

    System.out.println(100 - 2 * 3 ^ 3 + 4 ^ 2 / 2)
}