package hi

import org.example.Test

fun isOleg(name: String): Boolean {
    Wow().a()
    if (name == "Oleg") return true
    return false
}

class Wow {
    fun a() {
        System.out.println("No it's b")
    }

    constructor() {
        System.out.println("YAY!!!")
        Test("Hi").ok()
    }
}