package org.example

import java.util.ArrayList
import java.util.List
import java.lang.Math
import java.lang.Number
import java.lang.System
import java.io.PrintStream
import java.io.Closeable
import Wow

var testing = 52
val test2 = testing + 1

fun println(v: String?) {
    System.out.println(v)
}

fun main() {
    var a = 5
    while (a > 0) #outer {
        a--
        for (b: Int in [3, 2, 1]) {
            println("Counting down... " + b)
            if (b == 0) break #outer
            if (b == 1) break
        }
    }

    Test("Hi").ok()
    val cls: Ok = Inheritor()
    println(cls.test())
    System.out.println(cls.pupok())

    Wow()
}

class Test {
    private val a = 5

    constructor(arg: String) {
        var arg = arg + "hi, "

        if (arg.equals("no")) {
            System.out.println("Invalid arg!")
            return
        }

        System.out.println(arg + " ok")
    }

    fun ok(): Int {
        val b = 67
        return a + b
    }
}

interface Ok {
    fun test(): String = "testing"
    fun pupok(): Int
}

class Inheritor : Ok {
    override fun pupok(): Int = 152
}

abstract class AbstractClass : Ok {
    abstract fun hello()
}

class Lol : AbstractClass {

}